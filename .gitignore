# Java / Maven
api/target/
*.class

# Node / Vite
ui/node_modules/
ui/dist/
npm-debug.log*

# Env overrides (commit .env.example, not .env)
.env

# Campaign send logs (bind-mounted from the api container) — operational data,
# and they contain recipient addresses.
logs/

# Timestamped dumps kept by refresh-db-export.bat. A local safety net, not
# shared history: ~0.5 MB per run would bloat the repo, and the current export
# is committed as db-export/chartering-full.dump anyway.
db-export/history/

# Timestamped backups from backup-db.bat. Real data, including the send history
# and synced mail, and one folder per run - none of it belongs in the repo. Keep
# them somewhere that is not this disk; the script goes wherever you put it.
db-backup-*/

# Connection strings pasted while setting up a hosted database. Their real home is
# .env, ignored above - this is here so a scratch file on the way there cannot be
# committed by accident. A password in git history is a password you have to rotate.
db/creds.txt
*creds*.txt
*.credentials

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
