# Copy to .env to override defaults. The API's docker profile (api/src/main/
# resources/application.yml) hardcodes chartering_user/password, so if you change
# the DB credentials here, update that profile too.
POSTGRES_USER=chartering_user
POSTGRES_PASSWORD=password
POSTGRES_DB=chartering

# Host port mappings
DB_PORT=5433
API_PORT=8081
UI_PORT=8082

# The zone both containers treat as local. Timestamps in the circulation history and the
# campaign log are wall-clock time in this zone, and it decides where "today" starts for
# the day counter on the Circulars tab. Unset, both fall back to the same default.
# Existing history is stored as instants, so changing this re-reads old runs in the new
# zone rather than shifting them.
# After changing it: docker compose up -d --force-recreate api db
TZ=Europe/Warsaw

# ---------------------------------------------------------------------------
# Circulars (Zoho SMTP)
# ---------------------------------------------------------------------------
# .env is gitignored — put the real values there, never in this file.
# After changing any of these: docker compose up -d --force-recreate api
#
# There are two ways to send a circular, and which one is used is a runtime setting,
# not an environment variable: the "Use Brevo for circs" checkbox on the Settings tab.
# The Circulars tab always shows which is in force. This block configures the mailbox
# flow (SMTP); the Brevo block further down configures the other one. Both can be set
# up at once — only the one you tick is used.

# Master switch, and it covers both flows. Left false, the app still starts and the
# Circulars tab lets you compose and preview; it just refuses to send.
MAIL_ENABLED=false

# Zoho's EU data centre on implicit SSL. For STARTTLS instead:
# MAIL_PORT=587, MAIL_SSL=false, MAIL_STARTTLS=true
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false

# Your full Zoho mailbox address — the short username will not authenticate.
MAIL_USERNAME=
# An APP-SPECIFIC password (Zoho: Security -> App Passwords), not your login
# password, whenever two-factor auth is enabled on the account.
MAIL_PASSWORD=

# Zoho rejects a From that isn't the authenticated account or a verified alias,
# so this normally equals MAIL_USERNAME exactly.
MAIL_FROM=
MAIL_FROM_NAME=Chartering Desk
# Optional — where replies should land if not the sending mailbox.
MAIL_REPLY_TO=

# Optional but recommended: address published in the List-Unsubscribe header.
# A one-click opt-out is what stops recipients reporting the mail as spam instead,
# and spam complaints are what actually damage sender reputation.
MAIL_UNSUBSCRIBE=

# ---------------------------------------------------------------------------
# Circulars (Brevo transactional API) — the second flow
# ---------------------------------------------------------------------------
# Switched on from the Settings tab ("Use Brevo for circs"), not from here. Leaving the
# key blank simply means the checkbox has nothing to switch to, and the Settings tab
# says so rather than letting you select a flow that would fail on the first message.
#
# Two things to do in Brevo before this works:
#   1. SMTP & API -> API Keys -> generate a v3 key, and paste it below.
#   2. Senders, Domains & Dedicated IPs -> verify the address you send From. Brevo
#      refuses anything else, and it is the MAIL_FROM / Settings address that is used —
#      Brevo reuses the same From identity as the mailbox flow, so recipients see one
#      sender whichever way a circular went out.
#
# Bounces, blocks and per-message logs live in Brevo's own dashboard; the app records
# only what it was told at send time, exactly as it does for SMTP.
BREVO_API_KEY=

# ---- Brevo pacing defaults ----
# Deliberately much faster than the SMTP rails below. Those exist to stop a personal
# mailbox being suspended for exceeding its hourly cap; Brevo is built for bulk and
# absorbs the rate itself, so the only ceiling that really binds is the plan's daily
# allowance — which no amount of spacing changes. ~0.5s average means roughly a minute
# per 100 recipients.
# These are only what the Settings tab shows when nothing has been tuned: each provider
# stores its own pacing, so switching flows swaps the numbers and switching back
# restores them.
BREVO_MIN_DELAY_MS=200
BREVO_MAX_DELAY_MS=800
BREVO_MAX_RECIPIENTS=500
BREVO_BATCH_PAUSE_MS=60000

# ---- pacing and safety rails for the SMTP flow (defaults are deliberately conservative) ----
# The gap between two messages is drawn at random from this range, never fixed:
# a perfectly regular cadence is a machine fingerprint. 3-10s averages ~6.5s per
# message, so budget roughly 11 minutes per 100 recipients.
MAIL_MIN_DELAY_MS=3000
MAIL_MAX_DELAY_MS=10000

# Recipients per run. A longer list is not refused: it is sent as several runs of
# this size, MAIL_BATCH_PAUSE_MS apart, which keeps each burst inside the plan's
# per-hour allowance. It does not stretch a campaign past a *daily* limit — keep an
# eye on the total, since exceeding the daily limit can suspend outgoing mail on the
# whole account.
MAIL_MAX_RECIPIENTS=200

# Quiet gap between one run and the next of the same campaign. 0 sends them back to
# back, which defeats the point of splitting. Default 900000 = 15 minutes.
MAIL_BATCH_PAUSE_MS=900000

# Transient (4xx) failures are retried with a doubling backoff; permanent (5xx)
# ones never are. Consecutive failures abort the run, because repeated failures
# mean the provider is throttling us and pushing through escalates it to a block.
MAIL_MAX_RETRIES=2
MAIL_RETRY_BACKOFF_MS=10000
MAIL_ABORT_AFTER_FAILURES=5
