# Copy to .env to override defaults. The API's docker profile (api/src/main/
# resources/application.yml) hardcodes chartering_user/password, so if you change
# the DB credentials here, update that profile too.
POSTGRES_USER=chartering_user
POSTGRES_PASSWORD=password
POSTGRES_DB=chartering

# Host port mappings
DB_PORT=5433
API_PORT=8081
UI_PORT=8082
