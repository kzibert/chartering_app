# Copy to .env to override defaults.
#
# These three configure the local Postgres container. The API reads its own
# connection from DB_URL / DB_USER / DB_PASSWORD further down, which default to
# matching these - so if you change the credentials here, change them there too, or
# the api will be holding the old ones.
POSTGRES_USER=chartering_user
POSTGRES_PASSWORD=password
POSTGRES_DB=chartering

# Host port mappings
DB_PORT=5433
API_PORT=8081
UI_PORT=8082

# ---------------------------------------------------------------------------
# Which database the API talks to
# ---------------------------------------------------------------------------
# Unset, the api container uses the db service beside it and you can ignore this
# whole block. Set DB_URL to move the API onto a managed Postgres without changing
# any code: the README is the step-by-step, including how to get your data there.
#
# TLS is not optional on a hosted database, and for pgjdbc it rides on the url as a
# query parameter rather than as a separate setting:
#
#   DB_URL=jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/chartering?sslmode=require
#   DB_USER=chartering_owner
#   DB_PASSWORD=...
#
# Note this is a JDBC url, not the psql one the provider shows you. Providers hand
# out postgresql://user:pass@host/db - the conversion is: swap the scheme for
# jdbc:postgresql://, drop the user:pass@ (they go in DB_USER / DB_PASSWORD), keep
# the rest. Leaving credentials inline in a JDBC url mostly works and then fails
# confusingly the first time the password contains an @ or a /.
#DB_URL=
#DB_USER=
#DB_PASSWORD=

# Connection pool. The defaults suit a database in the next container: ten
# connections, held open.
#
# A serverless provider bills - or meters a free allowance - on how long the
# database is awake, and an idle pool keeps it awake indefinitely. Draining to zero
# is what lets it suspend:
#
#   DB_POOL_MAX=5
#   DB_POOL_MIN_IDLE=0
#   DB_POOL_IDLE_TIMEOUT_MS=30000
#   DB_HEALTH_CHECK=false
#
# That last one matters more than it looks on a deployed instance. /actuator/health
# includes the database by default, a deploy platform polls that endpoint around the
# clock, and each poll runs a query - so the pool settings above let the database
# sleep and the health check then refuses to let it. Turning it off leaves health
# meaning "the app is serving"; a database outage surfaces on real requests instead.
#
# The cost is a cold start, a second or so, on the first query after a quiet spell.
# Worth pairing with a longer IMAP_POLL_MS below, since a five-minute poll otherwise
# wakes the database twelve times an hour on its own.
#DB_POOL_MAX=
#DB_POOL_MIN_IDLE=
#DB_POOL_IDLE_TIMEOUT_MS=

# The zone both containers treat as local. Timestamps in the circulation history and the
# campaign log are wall-clock time in this zone, and it decides where "today" starts for
# the day counter on the Circulars tab. Unset, both fall back to the same default.
# Existing history is stored as instants, so changing this re-reads old runs in the new
# zone rather than shifting them.
# After changing it: docker compose up -d --force-recreate api db
TZ=Europe/Warsaw

# ---------------------------------------------------------------------------
# The login
# ---------------------------------------------------------------------------
# One account. The whole application is behind it - the api refuses every request that
# does not carry a token, and the ui shows a login screen until it has one.
#
# There is no default password. Leave AUTH_PASSWORD empty and the api starts, logs
# "no password configured", and refuses every login; the login screen says the same.
# That is deliberate - a default password on something reachable from a network is the
# same as no password, and it is the kind of default nobody gets round to changing.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# The better form, and the one to use on anything deployed: a BCrypt hash, so the
# plaintext password exists nowhere - not here, not in a Render environment group, not
# in your shell history. Set this and AUTH_PASSWORD above is ignored.
#
# Generate one with nothing installed but Docker:
#
#   docker run --rm httpd:alpine htpasswd -nbBC 10 admin 'your-password'
#
# It prints admin:$2y$10$... - take everything after the first colon, hash included.
# Spring Security accepts the $2y$ prefix htpasswd writes.
#
# Careful pasting it here: docker compose expands $VAR in .env values, and a BCrypt hash
# is full of $ signs. Either wrap the whole value in SINGLE quotes, or double every $.
# Single quotes are the sane option. This is the one variable in this file where it
# matters, and getting it wrong shows up as "wrong username or password" with a
# correct password.
AUTH_PASSWORD_HASH=

# Signs the session tokens. 32 characters minimum (HS256 needs a 256-bit key; the api
# refuses to start with a shorter one rather than quietly weakening the signature).
#
#   openssl rand -base64 48
#
# Left empty, the api generates a key at startup. That works, but it is a different key
# each time, so every `docker compose up -d --force-recreate api` logs you out. Fine on
# a laptop, wrong on a deployment.
JWT_SECRET=

# How long a session lasts before the password is asked for again. 720 = 12 hours.
# There is no revocation: a token is good until it expires or JWT_SECRET changes, which
# is the trade a stateless token makes and the reason not to set this to a month.
AUTH_TOKEN_TTL_MINUTES=720

# Brute-force rail: this many wrong passwords in a row and the login endpoint stops
# answering for AUTH_LOCKOUT_SECONDS. A successful login clears the count. Set the
# attempts to 0 to turn it off.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300

# Swagger UI and /v3/api-docs. Documentation, not data - the endpoints they describe
# still refuse anonymous callers - but there is no reason to publish a map of the API
# from a deployed instance. The Render blueprint sets this to false.
SWAGGER_ENABLED=true

# Browser origins allowed to call the api. Irrelevant in the normal setup: the ui's
# nginx proxies /api, so every call the browser makes is same-origin. It matters only
# when the two are served from different addresses - a Vite dev server, or a ui
# deployed apart from the api.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Circulars (Zoho SMTP)
# ---------------------------------------------------------------------------
# .env is gitignored — put the real values there, never in this file.
# After changing any of these: docker compose up -d --force-recreate api
#
# There are two ways to send a circular, and which one is used is a runtime setting,
# not an environment variable: the "Use Brevo for circs" checkbox on the Settings tab.
# The Circulars tab always shows which is in force. This block configures the mailbox
# flow (SMTP); the Brevo block further down configures the other one. Both can be set
# up at once — only the one you tick is used.

# Master switch, and it covers both flows. Left false, the app still starts and the
# Circulars tab lets you compose and preview; it just refuses to send.
MAIL_ENABLED=false

# Zoho's EU data centre on implicit SSL. For STARTTLS instead:
# MAIL_PORT=587, MAIL_SSL=false, MAIL_STARTTLS=true
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false

# Your full Zoho mailbox address — the short username will not authenticate.
MAIL_USERNAME=
# An APP-SPECIFIC password (Zoho: Security -> App Passwords), not your login
# password, whenever two-factor auth is enabled on the account.
MAIL_PASSWORD=

# Zoho rejects a From that isn't the authenticated account or a verified alias,
# so this normally equals MAIL_USERNAME exactly.
MAIL_FROM=
MAIL_FROM_NAME=Chartering Desk
# Optional — where replies should land if not the sending mailbox.
MAIL_REPLY_TO=

# Optional but recommended: address published in the List-Unsubscribe header.
# A one-click opt-out is what stops recipients reporting the mail as spam instead,
# and spam complaints are what actually damage sender reputation.
MAIL_UNSUBSCRIBE=

# ---- how a REPLY leaves, which is not the circulars setting ----
# SMTP (the default, and blank means SMTP) or BREVO. Replies normally go out through the
# mailbox whatever the Circulars tab is set to, because a reply has to come from the
# address the correspondent wrote to, thread with what they sent, and be in the mailbox's
# Sent folder next week. Leave this alone unless the deployment cannot do that.
#
# It cannot when the host blocks outbound SMTP. Render blocks ports 25, 465 and 587 on
# free instances, and the failure is not obvious: IMAP 993 is untouched, so the mailbox
# syncs perfectly and only replying breaks — with "Connect timed out" fifteen seconds
# later, because the packets are dropped rather than refused. Set BREVO there and a reply
# goes out through Brevo's API over HTTPS instead, still as the mailbox address.
#
# What that costs, both permanent:
#   - No Sent-folder copy. The message never touches the mailbox, so "your mailbox today"
#     will not count it and the app's own record is the only one there is.
#   - Threading may break. In-Reply-To and References are sent, but Brevo documents its
#     headers field as being for non-standard headers only, so the reply may open a new
#     thread rather than joining the correspondent's.
#
# It also needs the sending DOMAIN authenticated in Brevo, not just one verified sender:
# the From is the mailbox address, which is usually not the address circulars go out as.
# Brevo -> Senders, Domains & Dedicated IPs -> Domains, then the DKIM/SPF records in DNS.
# Without it every reply comes back 400 "Sender not valid".
#
# This is per-deployment on purpose and is deliberately NOT a Settings-tab option: the
# settings table lives in the database, and the hosted instance and the office one share
# that database while needing different answers here.
MAIL_REPLY_PROVIDER=

# ---------------------------------------------------------------------------
# Circulars (Brevo transactional API) — the second flow
# ---------------------------------------------------------------------------
# Switched on from the Settings tab ("Use Brevo for circs"), not from here. Leaving the
# key blank simply means the checkbox has nothing to switch to, and the Settings tab
# says so rather than letting you select a flow that would fail on the first message.
#
# Two things to do in Brevo before this works:
#   1. SMTP & API -> API Keys -> generate a v3 key, and paste it below.
#   2. Senders, Domains & Dedicated IPs -> verify the address you send From. Brevo
#      refuses anything else, and it is the MAIL_FROM / Settings address that is used —
#      Brevo reuses the same From identity as the mailbox flow, so recipients see one
#      sender whichever way a circular went out.
#
# Bounces, blocks and per-message logs live in Brevo's own dashboard; the app records
# only what it was told at send time, exactly as it does for SMTP.
BREVO_API_KEY=

# ---- Brevo daily allowance ----
# The plan's daily send ceiling, and only the denominator of the "left today" figure on the
# Circulars and Settings tabs — nothing enforces it, Brevo does. 300 is the free tier; raise
# it when the plan changes, or set 0 on a plan billed by purchased credits, which has no
# daily cap and where the quota figure is then hidden rather than shown against a number
# that does not apply.
#
# It has to be configured because Brevo publishes only what is LEFT of the allowance, never
# the allowance itself. Reconstructing it as "sent today + remaining" looks right and is not:
# the statistics report counts messages Brevo accepted, while the allowance is spent only by
# the ones it sends, so every blocked address adds one — and that report is compiled after
# the fact, lagging a running campaign by minutes, which moved the derived ceiling by tens
# between refreshes.
BREVO_DAILY_LIMIT=300

# ---- Brevo pacing defaults ----
# Deliberately much faster than the SMTP rails below. Those exist to stop a personal
# mailbox being suspended for exceeding its hourly cap; Brevo is built for bulk and
# absorbs the rate itself, so the only ceiling that really binds is the plan's daily
# allowance — which no amount of spacing changes. ~0.5s average means roughly a minute
# per 100 recipients.
# These are only what the Settings tab shows when nothing has been tuned: each provider
# stores its own pacing, so switching flows swaps the numbers and switching back
# restores them.
BREVO_MIN_DELAY_MS=200
BREVO_MAX_DELAY_MS=800
BREVO_MAX_RECIPIENTS=500
BREVO_BATCH_PAUSE_MS=60000

# ---- pacing and safety rails for the SMTP flow (defaults are deliberately conservative) ----
# The gap between two messages is drawn at random from this range, never fixed:
# a perfectly regular cadence is a machine fingerprint. 3-10s averages ~6.5s per
# message, so budget roughly 11 minutes per 100 recipients.
MAIL_MIN_DELAY_MS=3000
MAIL_MAX_DELAY_MS=10000

# Recipients per run. A longer list is not refused: it is sent as several runs of
# this size, MAIL_BATCH_PAUSE_MS apart, which keeps each burst inside the plan's
# per-hour allowance. It does not stretch a campaign past a *daily* limit — keep an
# eye on the total, since exceeding the daily limit can suspend outgoing mail on the
# whole account.
MAIL_MAX_RECIPIENTS=200

# Quiet gap between one run and the next of the same campaign. 0 sends them back to
# back, which defeats the point of splitting. Default 900000 = 15 minutes.
MAIL_BATCH_PAUSE_MS=900000

# Transient (4xx) failures are retried with a doubling backoff; permanent (5xx)
# ones never are. Consecutive failures abort the run, because repeated failures
# mean the provider is throttling us and pushing through escalates it to a block.
MAIL_MAX_RETRIES=2
MAIL_RETRY_BACKOFF_MS=10000
MAIL_ABORT_AFTER_FAILURES=5

# ---------------------------------------------------------------------------
# Mailbox (IMAP) — the Mailbox tab's incoming mail
# ---------------------------------------------------------------------------
# Reading the mailbox is configured separately from sending to it, because the two
# fail independently: an unreachable IMAP host must not stop a circular going out,
# and a spent sending quota must not stop the inbox refreshing.
#
# THE MAILBOX IS OPENED READ-ONLY. The app sets no flags, moves nothing and deletes
# nothing, and creates, renames or removes no folder. Every folder in the mailbox is
# mirrored into the Mailbox tab, so a message shows where the mail server's own filters
# put it; the tab's *own* folders and filing rules are additional, stored in Postgres,
# and the worst a mis-written rule can do is rearrange rows in this database.
#
# Off by default. Until IMAP_ENABLED=true and the credentials resolve, the tab loads
# and says plainly which settings are missing.
IMAP_ENABLED=true

# Zoho's EU data centre on implicit SSL. Other providers: imap.gmail.com,
# outlook.office365.com. For a STARTTLS port instead, set IMAP_PORT=143, IMAP_SSL=false.
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_SSL=true

# Left blank these fall back to MAIL_USERNAME / MAIL_PASSWORD — the usual case is one
# mailbox both read and written by the same account. Set them only when the app reads a
# different mailbox than it sends from. As with SMTP, Zoho needs an app-specific
# password when two-factor auth is on the account, and IMAP access has to be enabled
# under Mail Settings -> Mail Accounts.
IMAP_USERNAME=
IMAP_PASSWORD=

# Every folder in the mailbox is synced; this one names the folder read FIRST on each
# poll and the folder the tab opens on. Worth changing only if new mail does not arrive
# in a folder called INBOX.
IMAP_FOLDER=INBOX

# How often the poller wakes. An inbox is not a chat window, and every poll is a login
# against a mailbox that may rate-limit them. Default 300000 = 5 minutes.
IMAP_POLL_MS=300000

# The first sync has no cursor to resume from, so it reaches back this far and no
# further: pointing the app at a mailbox with fifteen years of mail in it must not mean
# downloading fifteen years of mail.
IMAP_INITIAL_DAYS=30

# Ceiling on one poll ACROSS ALL FOLDERS, oldest first. A backlog drains over several
# polls in arrival
# order rather than in one pass that holds the connection open for an hour.
IMAP_MAX_PER_POLL=200

# Longest body kept, per part. Bodies are stored to be searched and read; a message
# carrying a megabyte of quoted history is no more of either for keeping all of it.
IMAP_MAX_BODY_CHARS=200000

IMAP_CONNECT_TIMEOUT_MS=15000
IMAP_READ_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# ANALYSIS WORKBENCH (the Analysis tab) - LOCAL DEPLOYMENTS ONLY
# ---------------------------------------------------------------------------
# Keeps incoming mail as training data for a model that reads cargo offers and vessel
# opening positions: capture from the synced mailbox, label what each email is, write
# down what a model should extract from it, export the lot as JSONL for a finetuning
# job somewhere else.
#
# ON in compose, OFF on Render, and that is the intended split. This is a workbench -
# a corpus accumulated over months, worked through in long sittings, ending in a file
# handed to a training run elsewhere - and none of that belongs on a free instance that
# sleeps after fifteen minutes idle. Off means the tab is not in the navigation and
# every endpoint behind it answers 404; the table exists in every database either way,
# because Flyway builds one schema rather than one per environment.
ANALYSIS_ENABLED=true

# Longest email text kept per sample. A cap, not a target: past twenty thousand
# characters an email is a quoted chain, a disclaimer and a signature block rendered as
# text, none of which teaches a model anything about a cargo - and one 400KB Outlook
# thread would otherwise be the largest example in the set.
ANALYSIS_MAX_BODY_CHARS=20000

# Most messages one capture run will take. Capture is a synchronous request that reads
# bodies and writes a row each; this is what keeps "capture everything" from being one
# transaction over a mailbox with years in it. Hitting it is not an error - the run says
# how many matched, and running it again continues where it stopped.
ANALYSIS_MAX_CAPTURE=500
