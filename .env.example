# Copy to .env to override defaults. The API's docker profile (api/src/main/
# resources/application.yml) hardcodes chartering_user/password, so if you change
# the DB credentials here, update that profile too.
POSTGRES_USER=chartering_user
POSTGRES_PASSWORD=password
POSTGRES_DB=chartering

# Host port mappings
DB_PORT=5433
API_PORT=8081
UI_PORT=8082

# ---------------------------------------------------------------------------
# Circulars (Zoho SMTP)
# ---------------------------------------------------------------------------
# .env is gitignored — put the real values there, never in this file.
# After changing any of these: docker compose up -d --force-recreate api

# Master switch. Left false, the app still starts and the Circulars tab lets you
# compose and preview; it just refuses to send.
MAIL_ENABLED=false

# Zoho's EU data centre on implicit SSL. For STARTTLS instead:
# MAIL_PORT=587, MAIL_SSL=false, MAIL_STARTTLS=true
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false

# Your full Zoho mailbox address — the short username will not authenticate.
MAIL_USERNAME=
# An APP-SPECIFIC password (Zoho: Security -> App Passwords), not your login
# password, whenever two-factor auth is enabled on the account.
MAIL_PASSWORD=

# Zoho rejects a From that isn't the authenticated account or a verified alias,
# so this normally equals MAIL_USERNAME exactly.
MAIL_FROM=
MAIL_FROM_NAME=Chartering Desk
# Optional — where replies should land if not the sending mailbox.
MAIL_REPLY_TO=

# Optional but recommended: address published in the List-Unsubscribe header.
# A one-click opt-out is what stops recipients reporting the mail as spam instead,
# and spam complaints are what actually damage sender reputation.
MAIL_UNSUBSCRIBE=

# ---- pacing and safety rails (defaults are deliberately conservative) ----
# The gap between two messages is drawn at random from this range, never fixed:
# a perfectly regular cadence is a machine fingerprint. 3-10s averages ~6.5s per
# message, so budget roughly 11 minutes per 100 recipients.
MAIL_MIN_DELAY_MS=3000
MAIL_MAX_DELAY_MS=10000

# Recipients per run. A longer list is not refused: it is sent as several runs of
# this size, MAIL_BATCH_PAUSE_MS apart, which keeps each burst inside the plan's
# per-hour allowance. It does not stretch a campaign past a *daily* limit — keep an
# eye on the total, since exceeding the daily limit can suspend outgoing mail on the
# whole account.
MAIL_MAX_RECIPIENTS=200

# Quiet gap between one run and the next of the same campaign. 0 sends them back to
# back, which defeats the point of splitting. Default 900000 = 15 minutes.
MAIL_BATCH_PAUSE_MS=900000

# Transient (4xx) failures are retried with a doubling backoff; permanent (5xx)
# ones never are. Consecutive failures abort the run, because repeated failures
# mean the provider is throttling us and pushing through escalates it to a block.
MAIL_MAX_RETRIES=2
MAIL_RETRY_BACKOFF_MS=10000
MAIL_ABORT_AFTER_FAILURES=5
