<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.1</version>
		<relativePath/>
	</parent>
	<groupId>com.chartering</groupId>
	<artifactId>chartering-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>chartering-api</name>
	<description>Vessel-centric backend over the chartering database</description>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>2.7.0</springdoc.version>
		<jjwt.version>0.12.6</jjwt.version>
		<!--
			Connection the flyway-maven-plugin uses. Not the application's: the app reads
			application.yml and these are only for the command-line goals, which run
			outside Spring entirely. Override per invocation, e.g.
			mvn flyway:info -Dflyway.url=jdbc:postgresql://host:5432/chartering
		-->
		<flyway.url>jdbc:postgresql://localhost:5433/chartering</flyway.url>
		<flyway.user>chartering_user</flyway.user>
		<flyway.password>password</flyway.password>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!--
			Flyway owns the schema. It runs before Hibernate is handed the DataSource, so
			ddl-auto=validate below it is checking a schema Flyway has just finished
			bringing up to date rather than one somebody remembered to patch by hand.

			Split in two since Flyway 10: the Postgres dialect lives in its own artifact
			and flyway-core alone cannot talk to this database. Both versions come from
			the Spring Boot parent - do not pin them here, or an upgrade of the parent
			starts mixing a core with a dialect it was never tested against.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!--
			Authentication. Spring Security here is doing one job: refusing every request
			that does not carry a valid token, and hashing the one password with BCrypt.
			Its session, CSRF and form-login machinery is all switched off in
			SecurityConfig - a stateless API with a Bearer token needs none of it.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!--
			Signing and verifying the token. jjwt rather than Spring's own oauth2-jose
			resource server: there is no authorization server, no key rotation and no
			scopes here - just an HS256 signature over a username and an expiry - and the
			resource-server stack would be a great deal of configuration around the same
			few lines. impl and jackson are runtime-only by jjwt's own design; only the
			-api artifact is compiled against.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!--
			Health endpoint. Render polls one to decide whether a deploy came up, and
			/actuator/health answers "the application is serving" rather than "a port is
			open". Whether it also checks the database is DB_HEALTH_CHECK, and the answer
			depends on whether that database is allowed to sleep - see application.yml.
			Only health is exposed.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!--
			RFC 4180 is not "split on comma". A contacts export puts a whole labelled phone
			list inside one quoted cell - "Work,+32.3.821.13.35,Mobile,+32.475.89.02.67" -
			and company names carry commas of their own. Hand-rolling the quote handling is
			how an import silently shifts every column right on one row in a hundred.
		-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.12.0</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				The same migrations, driven from the command line instead of from app
				startup: mvn flyway:info to read the history, flyway:validate to check
				this checkout against a database, flyway:repair after a failed migration.

				Points at the dev profile's database by default - localhost:5433, the port
				compose publishes - and every field is overridable, so the same commands
				reach a cloud database with -Dflyway.url=... and nothing edited here.
			-->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<configuration>
					<url>${flyway.url}</url>
					<user>${flyway.user}</user>
					<password>${flyway.password}</password>
					<locations>
						<location>filesystem:src/main/resources/db/migration</location>
					</locations>
					<baselineOnMigrate>true</baselineOnMigrate>
					<baselineVersion>2</baselineVersion>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-postgresql</artifactId>
						<version>${flyway.version}</version>
					</dependency>
					<dependency>
						<groupId>org.postgresql</groupId>
						<artifactId>postgresql</artifactId>
						<version>${postgresql.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
